<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.jgjoe.byh.auth.MemberMapper">

    <select id="findById" resultType="io.github.jgjoe.byh.auth.Member">
        SELECT ID,
               PASSWORD_HASH,
               NAME
        FROM MEMBER
        WHERE ID = #{id}
    </select>

</mapper>
